{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Tiene que coincidir EXACTO con el nombre real del proyecto/Worker en
  // Cloudflare (el que se ve en el dashboard) y con "service" del binding
  // WORKER_SELF_REFERENCE de más abajo. El auto-setup de wrangler generó
  // estos dos valores de fuentes distintas (uno del proyecto de Cloudflare,
  // otro de package.json) y no coincidían — por eso falló el deploy con
  // "Service binding ... was not found" (código 10143).
  "name": "sistema-grafica",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sistema-grafica",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sistema_grafica_bd",
      "database_id": "aa4415cb-a8c0-435c-a616-5fc85919b844",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "cd1bbfaf05894f7496e77fe77cdf55b6",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
