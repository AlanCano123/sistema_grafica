{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Tiene que coincidir EXACTO con el nombre real del proyecto/Worker en
  // Cloudflare (el que se ve en el dashboard) y con "service" del binding
  // WORKER_SELF_REFERENCE de más abajo. El auto-setup de wrangler generó
  // estos dos valores de fuentes distintas (uno del proyecto de Cloudflare,
  // otro de package.json) y no coincidían — por eso falló el deploy con
  // "Service binding ... was not found" (código 10143).
  "name": "sistema-grafica",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sistema-grafica",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sistema_grafica_bd",
      "database_id": "aa4415cb-a8c0-435c-a616-5fc85919b844",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "cd1bbfaf05894f7496e77fe77cdf55b6",
    },
  ],
  // No sensibles — quedan acá porque `wrangler deploy` es declarativo:
  // lo que no está en este archivo no sobrevive al siguiente deploy,
  // aunque se haya cargado a mano en el dashboard (D1/KV ya andaban
  // bien porque están declarados acá; estas vars no lo estaban).
  // CDO_API_TOKEN / MAYA_API_PASSWORD NO van acá — esos quedan como
  // "Secret" (no "Text") en Settings → Variables & Secrets del
  // dashboard, que sí persisten aparte de cada deploy.
  "vars": {
    "CDO_API_BASE_URL": "http://api.argentina.cdopromocionales.com/v2/products",
    "MAYA_API_BASE_URL": "https://api.mayapublicidad.com",
    "MAYA_API_EMAIL": "artisticalaserkind@gmail.com",
  },
  "observability": {
    "enabled": true,
  },
}
